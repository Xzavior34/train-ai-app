# Copy this file to .env.local and fill in your own Supabase projects' values.
# Find these under Project Settings -> API in each Supabase dashboard.
# Never commit the real .env.local file - it's already in .gitignore.
#
# THREE SEPARATE SUPABASE PROJECTS, confirmed:
#
# 1. Sara Foundation - its own dedicated project. This is the URL/key that
#    used to be described as "the shared project for this whole app" -
#    that was correct before the three-project split was confirmed; it now
#    belongs to this one tenant only.
VITE_SUPABASE_URL=https://qibqouymqtpirtbyjvjr.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 2. Digital Training Organization - Train AI's own B2C tenant, and also
#    where Super Admin / Platform Owner accounts are provisioned
#    (info@trainailtd.com holds both the Digital Training Organization
#    'admin' role and the platform-wide 'super_admin' role here - one
#    account, two roles, no separate fourth project).
VITE_SUPABASE_DIGITAL_TRAINING_URL=your-digital-training-project-ref
VITE_SUPABASE_DIGITAL_TRAINING_ANON_KEY=your-digital-training-anon-public-key

# 3. B2B - every business-organization tenant (the three seeded demo orgs,
#    and every real business customer going forward), isolated
#    tenant-by-tenant inside this one project via organization_id + RLS,
#    the same model this app has always used at that level.
VITE_SUPABASE_B2B_URL=your-b2b-project-ref
VITE_SUPABASE_B2B_ANON_KEY=your-b2b-anon-public-key

# Any project left unconfigured (still showing the your-*-ref placeholder
# above) runs in demo mode for that project only - the other two work
# normally if they're configured.
#
# Sign-up routing (which of the three a brand-new account is created in) is
# decided by account type + email domain - see resolveProjectForSignUp() in
# src/services/supabaseClient.js. Sign-in routing is harder (a plain email
# doesn't say which of Digital Training/B2B it belongs to) and tries
# Digital Training Organization first, falling back to B2B once on a real
# auth rejection - see resolveProjectForSignIn()/fallbackProjectForSignIn().
