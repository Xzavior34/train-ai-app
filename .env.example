# Copy this file to .env.local and fill in your own Supabase projects' values.
# Find these under Project Settings -> API in each Supabase dashboard.
# Never commit the real .env.local file - it's already in .gitignore.
#
# TWO PRODUCTION SUPABASE PROJECTS:
#
# 1. Sara Foundation (Dedicated Project)
#    Dedicated single-tenant deployment boundary for Sara Foundation.
VITE_SUPABASE_SARA_URL=https://qibqouymqtpirtbyjvjr.supabase.co
VITE_SUPABASE_SARA_ANON_KEY=your-sara-anon-public-key

# Fallback alias for primary / Sara URL if VITE_SUPABASE_SARA_* is omitted:
VITE_SUPABASE_URL=https://qibqouymqtpirtbyjvjr.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 2. Train AI Shared Organization Database (Multi-Tenant Shared Project)
#    The shared database for:
#    - Train AI LTD / Ajimi.com (Platform Owner / Super Admin)
#    - Digital Users (Default organization for individual signups)
#    - All onboarded business organizations, academies, foundations, and B2B tenants
VITE_SUPABASE_SHARED_URL=https://jeobggrtxeybxvlwpxvn.supabase.co
VITE_SUPABASE_SHARED_ANON_KEY=your-shared-anon-public-key

# Fallback alias for B2B / Shared URL if VITE_SUPABASE_SHARED_* is omitted:
VITE_SUPABASE_B2B_URL=https://jeobggrtxeybxvlwpxvn.supabase.co
VITE_SUPABASE_B2B_ANON_KEY=your-b2b-anon-public-key

# If any project is left unconfigured, it degrades to demo mode for that project.
#
# Sign-up & Sign-in routing:
# - @sarafoundationafrica.com -> Sierra Foundation project
# - All other signups & signins (individuals, organizations, platform owners)
#   -> Train AI Shared Organization Database

