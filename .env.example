# Copy this file to .env.local and fill in your own Supabase projects' values.
# Find these under Project Settings -> API in each Supabase dashboard.
# Never commit the real .env.local file - it's already in .gitignore.
#
# TWO TRAIN AI 2.0 PRODUCTION SUPABASE PROJECTS:
#
# 1. Train AI 2.0 / Sara Foundation Database (Dedicated Project)
#    Dedicated deployment boundary for Sara Foundation tenant/application data.
VITE_SUPABASE_SARA_URL=https://jeobggrtxeybxvlwpxvn.supabase.co
VITE_SUPABASE_SARA_ANON_KEY=your-sara-anon-public-key

# Fallback alias for primary / Sara URL if VITE_SUPABASE_SARA_* is omitted:
VITE_SUPABASE_URL=https://jeobggrtxeybxvlwpxvn.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 2. Train AI 2.0 / Organization Database (Multi-Tenant Central Organization Project)
#    The shared platform database for:
#    - Train AI LTD / Ajimi.com (Platform Owner / Super Admin: trainailtd@gmail.com)
#    - Canonical Digital Users organization (Default org for individual signups)
#    - Individual users
#    - All onboarded business organizations, academies, foundations, and B2B tenants
VITE_SUPABASE_ORGANIZATION_URL=https://djikuoucsuhdiyrhsduz.supabase.co
VITE_SUPABASE_ORGANIZATION_ANON_KEY=your-org-anon-public-key

# Backward-compatibility aliases for Organization DB:
VITE_SUPABASE_SHARED_URL=https://djikuoucsuhdiyrhsduz.supabase.co
VITE_SUPABASE_SHARED_ANON_KEY=your-shared-anon-public-key
VITE_SUPABASE_B2B_URL=https://djikuoucsuhdiyrhsduz.supabase.co
VITE_SUPABASE_B2B_ANON_KEY=your-b2b-anon-public-key

# If any project is left unconfigured, it degrades to demo mode for that project.
#
# Sign-up & Sign-in routing:
# - @sarafoundationafrica.com / Sara tenants -> Train AI 2.0 Sara Foundation Database (jeobggrtxeybxvlwpxvn)
# - Platform Owner, Individual signups, B2B orgs -> Train AI 2.0 Organization Database (djikuoucsuhdiyrhsduz)

